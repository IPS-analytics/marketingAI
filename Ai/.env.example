# Скопируйте в .env и заполните реальными значениями:
#   cp .env.example .env
# Файл .env НЕ коммитится в git.

# PostgreSQL
POSTGRES_DB=kotlerdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-db-password

# Spring (локально хост :5433)
# На Render обязательно sslmode=require и префикс jdbc:
# SPRING_DATASOURCE_URL=jdbc:postgresql://dpg-xxxxx-a/dbname?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/kotlerdb
SERVER_PORT=8080

# JWT (сгенерируйте длинную случайную строку)
TOKEN_SIGNING_KEY=change-me-to-a-long-random-hex-or-string
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
